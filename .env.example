NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL Database Target
# Default local embedded PostgreSQL runs on port 54329 with persistent storage in ./data/postgres-data
DATABASE_URL=postgresql://postgres:password@localhost:54329/postgres

# Server-Side AI Assistant (Optional)
# If left blank, the assistant explicitly reports that AI is unconfigured and provides authorized platform context
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Payment Gateway Sandbox Mode
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_SECRET=sandbox_secret_key

# Mapping / Geo Services
MAP_PROVIDER=local
MAP_PROVIDER_API_KEY=
