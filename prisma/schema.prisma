generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  CUSTOMER
  COOPERATIVE_EMPLOYEE
  COOPERATIVE_ADMIN
  FEDERATION_ADMIN
  SUPER_ADMIN
}

enum JobStatus {
  DRAFT
  POSTED
  MATCHING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  RESOLVED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  ESCALATED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  mobile            String?
  name              String
  passwordHash      String
  role              Role
  accountStatus     String   @default("ACTIVE")
  emailVerifiedAt   DateTime?
  profileCompletion Int      @default(0)
  cooperativeId     String?
  federationId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workerProfile     WorkerProfile?
  customerProfile   CustomerProfile?
  employeeProfile   EmployeeProfile?
  cooperative        Cooperative? @relation(fields: [cooperativeId], references: [id])
  federation         Federation?  @relation(fields: [federationId], references: [id])
  sessions           Session[]
  settings           UserSetting?
  notifications      Notification[]
  welfareApplications WelfareApplication[]
  trainingEnrollments TrainingEnrollment[]
  sosIncidents       SosIncident[]
  aiConversations    AiConversation[]
  passwordResets     PasswordReset[]
  statusChanges      JobStatusHistory[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Federation {
  id           String        @id @default(cuid())
  name         String
  region       String
  status       String        @default("ACTIVE")
  cooperatives Cooperative[]
  users        User[]
}

model Cooperative {
  id               String            @id @default(cuid())
  federationId     String?
  name             String
  region           String
  policyFeePercent Int               @default(8)
  status           String            @default("ACTIVE")
  federation       Federation?       @relation(fields: [federationId], references: [id])
  users            User[]
  workers          WorkerProfile[]
  employees        EmployeeProfile[]
  jobs             Job[]
  wageRules        WageRule[]
}

model WorkerProfile {
  id                 String       @id @default(cuid())
  userId             String       @unique
  cooperativeId      String
  workerCode         String       @unique
  location           String
  latitude           Float?
  longitude          Float?
  serviceRadiusKm    Int          @default(10)
  yearsExperience    Int          @default(0)
  rating             Float        @default(0)
  completedJobs      Int          @default(0)
  verificationStatus String       @default("PENDING")
  availabilityStatus String       @default("AVAILABLE")
  languages          String[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cooperative        Cooperative  @relation(fields: [cooperativeId], references: [id])
  skills             WorkerSkill[]
  certifications     Certification[]
}

model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  location       String?
  savedAddresses String[]
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmployeeProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  cooperativeId String?
  employeeCode  String       @unique
  department    String       @default("Operations")
  designation   String       @default("Cooperative Coordinator")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cooperative   Cooperative? @relation(fields: [cooperativeId], references: [id])
}

model ServiceCategory {
  id                   String            @id @default(cuid())
  name                 String            @unique
  baseHourlyRate       Int
  complexityMultiplier Float             @default(1)
  skills               Skill[]
  jobs                 Job[]
  wageRules            WageRule[]
  trainingPrograms     TrainingProgram[]
}

model Skill {
  id         String          @id @default(cuid())
  name       String
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id])
  workers    WorkerSkill[]
}

model WorkerSkill {
  workerId String
  skillId  String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill    Skill         @relation(fields: [skillId], references: [id])
  @@id([workerId, skillId])
}

model Certification {
  id        String        @id @default(cuid())
  workerId  String
  name      String
  issuedBy  String
  issuedAt  DateTime?
  fileKey   String?
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model Job {
  id                     String       @id @default(cuid())
  customerId             String
  workerId               String?
  cooperativeId          String
  serviceCategoryId      String
  title                  String
  description            String
  requirements           String[]
  location               String
  scheduledAt            DateTime
  estimatedDurationHours Int
  budget                 Int
  fairWageEstimate       Int
  finalAmount            Int?
  status                 JobStatus    @default(POSTED)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  cooperative            Cooperative  @relation(fields: [cooperativeId], references: [id])
  serviceCategory        ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
  matchScores            MatchScore[]
  payments               Payment[]
  reviews                Review[]
  disputes               Dispute[]
  statusHistory          JobStatusHistory[]
}

model JobStatusHistory {
  id          String    @id @default(cuid())
  jobId       String
  fromStatus  JobStatus
  toStatus    JobStatus
  changedById String?
  reason      String?
  createdAt   DateTime  @default(now())
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changedBy   User?     @relation(fields: [changedById], references: [id])
  @@index([jobId, createdAt])
}

model MatchScore {
  id         String   @id @default(cuid())
  jobId      String
  workerId   String
  score      Int
  reasons    Json
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, score])
}

model WageRule {
  id                String          @id @default(cuid())
  cooperativeId     String
  serviceCategoryId String
  skillLevel        String
  minimumHourlyRate Int
  platformFeePercent Int
  active            Boolean         @default(true)
  cooperative       Cooperative     @relation(fields: [cooperativeId], references: [id])
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id])
}

model Payment {
  id        String   @id @default(cuid())
  jobId     String
  payerId   String
  workerId  String?
  amount    Int
  status    String
  provider  String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  jobId      String
  customerId String
  workerId   String?
  rating     Int
  body       String?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id])
  @@unique([jobId, customerId])
}

model UserSetting {
  id            String   @id @default(cuid())
  userId        String   @unique
  language      String   @default("en")
  theme         String   @default("light")
  notifications Json
  privacy       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WelfareScheme {
  id           String               @id @default(cuid())
  name         String
  description  String
  eligibility  String
  documents    String[]
  organization String?
  applications WelfareApplication[]
}

model TrainingProgram {
  id                String               @id @default(cuid())
  title             String
  serviceCategoryId String
  skillsCovered     String[]
  durationHours     Int
  provider          String
  serviceCategory   ServiceCategory      @relation(fields: [serviceCategoryId], references: [id])
  enrollments       TrainingEnrollment[]
}

model Dispute {
  id          String        @id @default(cuid())
  jobId       String
  createdById String
  reason      String
  status      DisputeStatus @default(OPEN)
  comments    Json
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  job         Job           @relation(fields: [jobId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, read])
}

model Conversation {
  id             String    @id @default(cuid())
  jobId          String?
  participantIds String[]
  unreadBy       String[]  @default([])
  createdAt      DateTime  @default(now())
  messages       Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  status         String       @default("SENT")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model WelfareApplication {
  id        String        @id @default(cuid())
  schemeId  String
  userId    String
  status    String        @default("SUBMITTED")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  scheme    WelfareScheme @relation(fields: [schemeId], references: [id])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainingEnrollment {
  id              String          @id @default(cuid())
  programId       String
  userId          String
  status          String          @default("ENROLLED")
  progressPercent Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  program         TrainingProgram @relation(fields: [programId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SosIncident {
  id        String   @id @default(cuid())
  userId    String
  jobId     String?
  location  String
  status    String   @default("OPEN")
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
}

model AiMessage {
  id                 String         @id @default(cuid())
  conversationId     String
  role               String
  body               String
  facts              String[]       @default([])
  sourceType         String         @default("LOCAL")
  providerConfigured Boolean        @default(false)
  createdAt          DateTime       @default(now())
  conversation       AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
